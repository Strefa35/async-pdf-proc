# Copy and set your real values
GOOGLE_API_KEY="your_google_key"
# For local mock this can stay as default; for real API set your key:
# MISTRAL_API_KEY="your_mistral_key"
# GEMINI_MODEL="gemini-2.5-flash"
# MISTRAL_MODEL="mistral-small-latest"
# MISTRAL_API_BASE_URL="https://api.mistral.ai"
# Parser mistral-ocr (raster + Mistral vision, one chat completion per page):
# MISTRAL_OCR_MODEL="mistral-small-latest"
# MISTRAL_OCR_MAX_PAGES="25"
# MISTRAL_OCR_RASTER_ZOOM="1.75"
# REDIS_URL="redis://redis:6379/0"
# Bounded thread pool for PyPDF + blocking Gemini SDK (backend and worker):
# BLOCKING_POOL_MAX_WORKERS="8"
# Concurrent sync files in POST /api/pdf/extract (per-request parallelism cap):
# SYNC_EXTRACT_MAX_CONCURRENT="8"
# Global LLM concurrency (Gemini SDK + Mistral markdown HTTP); saturated → 503 + Retry-After:
# LLM_MAX_INFLIGHT="8"
# Seconds to wait for an LLM slot (queue). 0 = fail fast when saturated. inf / -1 = wait indefinitely:
# LLM_SLOT_ACQUIRE_TIMEOUT_SECONDS="60"
# Wall-clock timeouts (seconds):
# GEMINI_CALL_TIMEOUT_SECONDS="180"
# Max PDF size (bytes) for parser gemini-2.5-flash-pdf inline multimodal upload (default 20 MiB):
# GEMINI_INLINE_PDF_MAX_BYTES="20971520"
# PDF_PARSE_TIMEOUT_SECONDS="120"
# MISTRAL_HTTP_TIMEOUT_SECONDS="120"
#
# Async worker / Redis Streams (see docs/STREAMS_CONTRACT.md):
# REDIS_STREAM_DLQ="doc_jobs_dlq"
# JOB_MAX_PROCESS_ATTEMPTS="5"
# JOB_MAX_RECLAIMS_PER_MESSAGE="8"
# JOB_STREAM_CLAIM_IDLE_MS="600000"
# WORKER_XREADGROUP_COUNT="5"
# WORKER_XREADGROUP_BLOCK_MS="5000"
# WORKER_METRICS_PORT="9464"
# JOB_RETRY_BASE_DELAY_SECONDS="1"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"
# OTEL_SERVICE_NAME="pdf-proc-worker"
# OTEL_SDK_DISABLED="false"

